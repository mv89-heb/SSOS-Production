# Local development defaults. Production values and secrets are configured in Render.
# Leave DATABASE_URL unset to use the local SQLite database under instance/.
FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=local-development-only-change-me

# Local browser session and frontend origin
SESSION_COOKIE_SECURE=False
WTF_CSRF_ENABLED=True
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE=5242880

# Local rate limiting. Production must use the shared Render Key Value URL.
RATELIMIT_LOGIN=10 per minute
RATELIMIT_REGISTER=5 per hour
RATELIMIT_STORAGE_URI=memory://

# Gemini is opt-in locally. Configure a valid API key before enabling it.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=120
GEMINI_THINKING_LEVEL=low

# Google Calendar OAuth — optional for local development.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Jerusalem

# Web Push / VAPID — optional for local development.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Reminder worker.
REMINDER_EXECUTION_WINDOW_MINUTES=5
