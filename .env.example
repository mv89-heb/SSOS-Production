# Neon PostgreSQL connection string. Either postgres:// or postgresql:// works;
# the app rewrites postgres:// to postgresql:// automatically. Include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/ssos?sslmode=require

# Flask
FLASK_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY=change-this-to-a-long-random-value

# Security
SESSION_COOKIE_SECURE=True
WTF_CSRF_ENABLED=True

# CORS — comma-separated list of origins allowed to call this API with
# credentials (the Next.js frontend's deployed URL).
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.example.com

# Public URLs used by OAuth and calendar event links.
API_PUBLIC_URL=https://your-backend-domain.example.com
FRONTEND_PUBLIC_URL=https://your-frontend-domain.example.com

# Uploads
MAX_UPLOAD_SIZE=5242880

# Rate limiting
RATELIMIT_LOGIN=10 per minute
RATELIMIT_STORAGE_URI=memory://

# Gemini AI — already configured in Render for production.
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30

# Google Calendar OAuth — create an OAuth Web Application in Google Cloud.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-backend-domain.example.com/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_TIMEZONE=Asia/Jerusalem
